CREATE OR REPLACE PROCEDURE cambiar_estado_usuario(usuario_id_param INT)
LANGUAGE plpgsql
AS $$
BEGIN
    -- Cambia el estado al valor opuesto (si es true pasa a false, y viceversa)
    UPDATE public.users
    SET status = NOT status
    WHERE id = usuario_id_param;

    -- Mensaje de confirmación en consola
    IF FOUND THEN
        RAISE NOTICE 'Estado del usuario con ID % actualizado correctamente.', usuario_id_param;
    ELSE
        RAISE NOTICE 'No se encontró ningún usuario con el ID %.', usuario_id_param;
    END IF;
END;
$$;